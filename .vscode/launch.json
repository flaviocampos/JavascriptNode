{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug cli.js (texto-web.txt)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/cli.js",
      "args": ["${workspaceFolder}/arquivos/texto-web.txt", "${workspaceFolder}/resultados"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug cli.js (ERRO - arquivo inexistente)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/cli.js",
      "args": ["${workspaceFolder}/arquivos/texto-web", "${workspaceFolder}/resultados"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
